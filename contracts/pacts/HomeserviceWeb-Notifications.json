{
  "consumer": {
    "name": "HomeserviceWeb"
  },
  "interactions": [
    {
      "description": "list own inbox",
      "providerStates": [
        {
          "name": "customer has unread notification"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer pact-customer"
        },
        "method": "GET",
        "path": "/api/notifications"
      },
      "response": {
        "body": [
          {
            "body": "Booking #8001 is complete",
            "created_at": "2026-01-01T00:00:00",
            "id": 41,
            "order_id": 8001,
            "read_at": null,
            "title": "How did it go?",
            "type": "rating_request"
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].body": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].created_at": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$[*].title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "mark own notification read with idempotency key",
      "providerStates": [
        {
          "name": "customer has unread notification"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer pact-customer",
          "Idempotency-Key": "11111111-1111-4111-8111-111111111111"
        },
        "matchingRules": {
          "header": {
            "Idempotency-Key": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[a-f0-9-]{36}$"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/notifications/41/read"
      },
      "response": {
        "body": {
          "body": "Booking #8001 is complete",
          "created_at": "2026-01-01T00:00:00",
          "id": 41,
          "order_id": 8001,
          "read_at": "2026-01-01T00:01:00",
          "title": "How did it go?",
          "type": "rating_request"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.body": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.created_at": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.read_at": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "reject another customer marking notification read",
      "providerStates": [
        {
          "name": "customer has unread notification"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer pact-other",
          "Idempotency-Key": "22222222-2222-4222-8222-222222222222"
        },
        "matchingRules": {
          "header": {
            "Idempotency-Key": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[a-f0-9-]{36}$"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/notifications/41/read"
      },
      "response": {
        "body": {
          "detail": "not your notification"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 403
      }
    },
    {
      "description": "list empty inbox",
      "providerStates": [
        {
          "name": "empty inbox"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer pact-other"
        },
        "method": "GET",
        "path": "/api/notifications"
      },
      "response": {
        "body": [],
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "reject invalid credentials",
      "providerStates": [
        {
          "name": "empty inbox"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer invalid"
        },
        "method": "GET",
        "path": "/api/notifications"
      },
      "response": {
        "body": {
          "detail": "invalid token"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 401
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "Notifications"
  }
}