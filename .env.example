# Optional overrides for the local bootstrap. Blank secret fields are generated
# randomly in the stack-config Docker volume on first docker compose up.
# Copy to .env.notifications only if you need explicit local overrides.
NOTIFICATIONS_DB_PASSWORD=
RABBITMQ_PASSWORD=
JWT_SECRET=
KEYCLOAK_ADMIN_PASSWORD=
PROVISIONER_CLIENT_SECRET=
LEGACY_SOURCE_ID=
JWT_ISSUER=http://localhost:8080/auth/realms/homeservice
JWT_JWKS_URL=http://keycloak:8080/auth/realms/homeservice/protocol/openid-connect/certs
